{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build webget",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}",
                "--target",
                "webget",
                "-j"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            // 工作区根目录本身就是 CMake 构建目录（存在 CMakeCache.txt）
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "编译 apps/webget（Debug 启动前会自动执行）"
        },
        {
            "label": "build all",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}",
                "-j"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "编译全部目标"
        },
        {
            "label": "cmake: set Debug build type",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-DCMAKE_BUILD_TYPE=Debug",
                "${workspaceFolder}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "把构建类型改为 Debug（-O0 -g），之后需要重新编译；断点/单步更可靠"
        }
    ]
}